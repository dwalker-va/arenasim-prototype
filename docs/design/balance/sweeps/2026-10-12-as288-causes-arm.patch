+//! AS-288 measurement instrument (not shipped): the `ally_in_danger` bank of
+//! `tests/ally_in_danger_windows.rs`, with every onset and end's cause logged
+//! by `situation::aid_probe`. Writes `probe|<profile>|<map>|<comp>|<seed>|...`
+//! lines to `$AID_OUT`; `2026-10-12-as288-causes.py` reduces them.
+mod common;
+use arenasim::headless::HeadlessMatchConfig;
+use arenasim::states::play_match::situation::{AID_LOG, AID_PROBE};
+use common::staged::play_seeded;
+use std::io::Write;
+
+const COMPS: &[(&[&str], &[&str])] = &[
+    (&["Mage", "Priest"], &["Warrior", "Druid"]),
+    (&["Warlock", "Shaman"], &["Rogue", "Priest"]),
+    (&["Hunter", "Paladin"], &["Warrior", "Mage"]),
+    (&["Rogue", "Druid"], &["Hunter", "Priest"]),
+    (&["Warrior", "Shaman"], &["Rogue", "Warlock"]),
+    (&["Paladin", "Mage"], &["Warrior", "Hunter"]),
+    (&["Warrior", "Druid"], &["Hunter", "Shaman"]),
+];
+
+#[test]
+#[ignore]
+fn aid_causes() {
+    let mut f = std::fs::File::create(std::env::var("AID_OUT").expect("AID_OUT")).unwrap();
+    AID_PROBE.store(true, std::sync::atomic::Ordering::Relaxed);
+    for profile in ["Legacy", "TeamPlan"] {
+        for map in ["PillaredArena", "BasicArena"] {
+            for (ci, (t1, t2)) in COMPS.iter().enumerate() {
+                for seed in 1..9u64 {
+                    AID_LOG.lock().unwrap().clear();
+                    play_seeded(HeadlessMatchConfig {
+                        team1: t1.iter().map(|s| s.to_string()).collect(),
+                        team2: t2.iter().map(|s| s.to_string()).collect(),
+                        map: map.to_string(),
+                        random_seed: Some(seed),
+                        ai_profile: Some(profile.to_string()),
+                        ..Default::default()
+                    });
+                    for l in AID_LOG.lock().unwrap().drain(..) {
+                        writeln!(f, "probe|{profile}|{map}|{ci}|{seed}|{l}").unwrap();
+                    }
+                }
+            }
+        }
+    }
+}
