+//! AS-389 PROTOTYPES (scratch, never shipped). Gated by env vars so one
+//! binary runs every arm: `AS389_P` (comma list of prototype names) and
+//! `AS389_TEAMS` (comma list of team numbers, default "1,2").
+use std::sync::OnceLock;
+
+use bevy::prelude::*;
+
+use crate::states::play_match::arena_bounds::ArenaBounds;
+use crate::states::play_match::map_geometry::{has_line_of_sight, ObstacleVolume, EYE_HEIGHT};
+
+fn cfg() -> &'static (Vec<String>, Vec<u8>) {
+    static C: OnceLock<(Vec<String>, Vec<u8>)> = OnceLock::new();
+    C.get_or_init(|| {
+        let p = std::env::var("AS389_P").unwrap_or_default();
+        let t = std::env::var("AS389_TEAMS").unwrap_or_else(|_| "1,2".into());
+        (
+            p.split(',').filter(|s| !s.is_empty()).map(|s| s.to_string()).collect(),
+            t.split(',').filter_map(|s| s.trim().parse().ok()).collect(),
+        )
+    })
+}
+
+pub fn on(name: &str, team: u8) -> bool {
+    let (p, t) = cfg();
+    p.iter().any(|x| x == name) && t.contains(&team)
+}
+
+pub fn param(name: &str, default: f32) -> f32 {
+    std::env::var(name).ok().and_then(|s| s.parse().ok()).unwrap_or(default)
+}
+
+fn eye(p: Vec3) -> Vec3 {
+    Vec3::new(p.x, EYE_HEIGHT, p.z)
+}
+
+pub fn sees(obstacles: &[ObstacleVolume], a: Vec3, b: Vec3) -> bool {
+    has_line_of_sight(obstacles, eye(a), eye(b))
+}
+
+/// PINCER: in the lone-healer endgame, our healer takes the far side of the
+/// hider's pillar from our DPS, so the hider cannot hide from both.
+pub fn pincer(
+    commands: &mut Commands,
+    entity: Entity,
+    my_pos: Vec3,
+    free_or_pressured: bool,
+    ctx: &super::CombatContext,
+    now: f32,
+) -> Option<bool> {
+    use crate::states::play_match::components::{MovementDirective, MovementGoal};
+    let me = ctx.combatants.get(&entity)?;
+    if !on("pincer", me.team) || ctx.obstacles.is_empty() || !free_or_pressured {
+        return None;
+    }
+    let enemies: Vec<_> = ctx
+        .combatants
+        .values()
+        .filter(|i| i.team != me.team && i.is_alive && !i.is_pet)
+        .collect();
+    if enemies.len() != 1 || !enemies[0].class.is_healer() {
+        return None;
+    }
+    let hider = enemies[0];
+    let dps: Vec<Vec3> = ctx
+        .combatants
+        .values()
+        .filter(|i| i.team == me.team && i.is_alive && !i.is_pet && i.entity != entity)
+        .map(|i| i.position)
+        .collect();
+    if dps.is_empty() {
+        return None;
+    }
+    // A teammate below half: heal first, the posture decides.
+    if ctx.combatants.values().any(|i| {
+        i.team == me.team && i.is_alive && !i.is_pet && i.current_health < 0.5 * i.max_health
+    }) {
+        return None;
+    }
+    let t = Vec2::new(hider.position.x, hider.position.z);
+    let (c, rad) = ctx
+        .obstacles
+        .iter()
+        .map(|v| v.footprint_disc())
+        .min_by(|a, b| (a.0.distance(t) - a.1).total_cmp(&(b.0.distance(t) - b.1)))?;
+    if c.distance(t) - rad > 8.0 {
+        return None;
+    }
+    let mean = dps.iter().fold(Vec2::ZERO, |a, p| a + Vec2::new(p.x, p.z)) / dps.len() as f32;
+    let u = (mean - c).normalize_or_zero();
+    if u == Vec2::ZERO {
+        return None;
+    }
+    let r = param("AS389_PINCER_R", rad + 12.0);
+    let p = c - u * r;
+    let me_xz = Vec2::new(my_pos.x, my_pos.z);
+    if sees(ctx.obstacles, my_pos, hider.position) && me_xz.distance(t) <= 28.0 {
+        commands.entity(entity).remove::<MovementDirective>();
+        return Some(false);
+    }
+    commands.entity(entity).try_insert(MovementDirective {
+        goal: MovementGoal::Point(Vec3::new(p.x, my_pos.y, p.y)),
+        expires: now + 1.0,
+        committed_until: now + 0.6,
+    });
+    Some(false)
+}
+
+/// The nearest standable spot (rings of 2..16yd, 16 headings) that sees
+/// `target` from within `[min_range, max_range]`, and `keep` too when given.
+pub fn vantage_point(
+    obstacles: &[ObstacleVolume],
+    bounds: &ArenaBounds,
+    me: Vec3,
+    target: Vec3,
+    min_range: f32,
+    max_range: f32,
+    keep: Option<Vec3>,
+) -> Option<Vec3> {
+    for r in [2.0f32, 4.0, 6.0, 8.0, 10.0, 12.0, 16.0] {
+        let mut best: Option<(f32, Vec3)> = None;
+        for k in 0..16 {
+            let a = k as f32 * std::f32::consts::TAU / 16.0;
+            let p = me + Vec3::new(a.cos(), 0.0, a.sin()) * r;
+            if !bounds.contains(p) {
+                continue;
+            }
+            if obstacles.iter().any(|v| {
+                let (c, rad) = v.footprint_disc();
+                Vec2::new(p.x, p.z).distance(c) < rad + 0.8
+            }) {
+                continue;
+            }
+            let d = p.distance(target);
+            if d > max_range || d < min_range {
+                continue;
+            }
+            if !sees(obstacles, p, target) {
+                continue;
+            }
+            if keep.is_some_and(|h| !sees(obstacles, p, h)) {
+                continue;
+            }
+            // Among this ring's hits, the one nearest the target's range
+            // middle keeps the DPS from walking into it.
+            let score = (d - (min_range + max_range) * 0.5).abs();
+            if best.is_none_or(|(s, _)| score < s) {
+                best = Some((score, p));
+            }
+        }
+        if let Some((_, p)) = best {
+            return Some(p);
+        }
+    }
+    None
+}
