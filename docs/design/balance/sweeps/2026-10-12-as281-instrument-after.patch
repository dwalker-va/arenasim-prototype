+/// How far short of the cover that hides a lane the landing is pulled back to
+/// ([`sighted_lane`]), so the trap lands clear of the pillar's skin.
+const LANE_COVER_MARGIN: f32 = 1.0;
+
+/// Where a LANE throw lands: `lane` itself when the Hunter can see it, else
+/// the farthest point it can see along the line of the throw, short of the
+/// cover that hides the rest by [`LANE_COVER_MARGIN`]. A lane is aimed at no
+/// one — it is a spot on the way between the Hunter and the enemy — so a spot
+/// nearer on the same line is the same decision; every other placement is
+/// aimed at a unit, and a hidden one is held instead
+/// ([`try_place_trap_at`]). Sight along one line from the Hunter is lost at
+/// the first cover it meets and never regained, so a bisection finds the
+/// edge. A no-op with no obstacles.
+fn sighted_lane(
+    obstacles: &[crate::states::play_match::map_geometry::ObstacleVolume],
+    my_pos: Vec3,
+    lane: Vec3,
+) -> Vec3 {
+    use crate::states::play_match::map_geometry::has_line_of_sight;
+    if !as281_lane_on() || has_line_of_sight(obstacles, my_pos, lane) {
+        return lane;
+    }
+    let (mut seen, mut hidden) = (0.0_f32, 1.0_f32);
+    for _ in 0..24 {
+        let t = (seen + hidden) / 2.0;
+        if has_line_of_sight(obstacles, my_pos, my_pos.lerp(lane, t)) {
+            seen = t;
+        } else {
+            hidden = t;
+        }
+    }
+    let length = my_pos.distance(lane);
+    let back = if length > 0.0 {
+        LANE_COVER_MARGIN / length
+    } else {
+        0.0
+    };
+    my_pos.lerp(lane, (seen - back).max(0.0))
 }
 
