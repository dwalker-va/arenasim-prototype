+// AS-281 measurement instrument (stderr only; never read by the sim).
+thread_local! {
+    static AS281_NOW: std::cell::Cell<f32> = const { std::cell::Cell::new(0.0) };
+}
+thread_local! {
+    static AS281_PATH: std::cell::Cell<&'static str> = const { std::cell::Cell::new("-") };
+}
+fn as281_exempt() -> bool {
+    static EXEMPT: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+    let list = EXEMPT.get_or_init(|| {
+        std::env::var("AS281_EXEMPT")
+            .unwrap_or_default()
+            .split(',')
+            .filter(|s| !s.is_empty())
+            .map(String::from)
+            .collect()
+    });
+    let path = AS281_PATH.with(|c| c.get());
+    list.iter().any(|p| p == path)
+}
+fn as281_lane_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("AS281_LANE").map_or(true, |v| v != "0"))
+}
+fn as281_path(p: &'static str) {
+    AS281_PATH.with(|c| c.set(p));
+}
+fn as281(tag: &str) {
+    eprintln!(
+        "AS281 {:.3} {} {}",
+        AS281_NOW.with(|n| n.get()),
+        tag,
+        AS281_PATH.with(|c| c.get())
+    );
+}
