+/// AS-383 measurement instrument (throwaway, measurement only). Under
+/// `TeamPlan`, one JSON line per posture evaluation to `$AS383_LOG`: the
+/// posture, the pressure test, the Priest's position and standing goal, its
+/// crowd-control field (ready threats, and whether each covers it), the reach
+/// repair's last outcome, and every living enemy's position and target.
+#[allow(clippy::too_many_arguments)]
+fn as383_instrument(
+    entity: Entity,
+    my_pos: Vec3,
+    ctx: &CombatContext,
+    abilities: &AbilityDefinitions,
+    state: &HealerPosture,
+    directive: Option<&MovementDirective>,
+    shared: &SharedMovementConfig,
+    now: f32,
+    trigger: bool,
+    onset: bool,
+) {
+    let Ok(path) = std::env::var("AS383_LOG") else {
+        return;
+    };
+    if !ctx.ai_profile.is_team_plan() {
+        return;
+    }
+    use std::io::Write;
+    let me = Vec2::new(my_pos.x, my_pos.z);
+    let field = super::cc_reach::CcField::for_healer(
+        ctx,
+        abilities,
+        entity,
+        shared.cc_ready_horizon,
+        shared.cc_reach_margin,
+    );
+    let threats: Vec<serde_json::Value> = field
+        .threats
+        .iter()
+        .map(|t| {
+            serde_json::json!({
+                "ab": format!("{:?}", t.ability),
+                "src": t.source.index(),
+                "c": [t.center.x, t.center.y],
+                "reach": t.reach,
+                "d": t.center.distance(me),
+                "inner": field.covering(ctx.obstacles, me, super::cc_reach::Disc::Inner).any(|c| c.source == t.source && c.ability == t.ability),
+                "outer": field.covering(ctx.obstacles, me, super::cc_reach::Disc::Outer).any(|c| c.source == t.source && c.ability == t.ability),
+            })
+        })
+        .collect();
+    let my_team = ctx.combatants.get(&entity).map(|c| c.team).unwrap_or(0);
+    let units: Vec<serde_json::Value> = ctx
+        .combatants
+        .values()
+        .filter(|c| c.is_alive && c.entity != entity)
+        .map(|c| {
+            serde_json::json!({
+                "e": c.entity.index(),
+                "cls": format!("{:?}", c.class),
+                "ally": c.team == my_team,
+                "pet": c.is_pet,
+                "p": [c.position.x, c.position.z],
+                "hp": c.current_health / c.max_health.max(1.0),
+                "tme": c.target == Some(entity),
+                "cast": c.casting_ability.map(|a| format!("{a:?}")),
+            })
+        })
+        .collect();
+    let goal = directive.map(|d| match d.goal {
+        MovementGoal::Point(p) => serde_json::json!(["pt", p.x, p.z]),
+        MovementGoal::Direction(v) => serde_json::json!(["dir", v.x, v.y]),
+        MovementGoal::Entity(e) => serde_json::json!(["ent", e.index()]),
+    });
+    let line = serde_json::json!({
+        "t": now,
+        "e": entity.index(),
+        "post": format!("{:?}", state.posture),
+        "trig": trigger,
+        "onset": onset,
+        "p": [me.x, me.y],
+        "goal": goal,
+        "kept": state.formation.reach.map(|k| [k.x, k.y]),
+        "repair": super::formation::as383_last_repair(),
+        "thr": threats,
+        "u": units,
+    });
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(f, "{line}");
+    }
+}
+
+/// AS-383 EXPERIMENT knob (throwaway, never shipped): `$AS383_EXP` names the
+/// variants to run, comma-separated.
+pub fn as383_exp(name: &str) -> bool {
+    static EXP: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+    EXP.get_or_init(|| {
+        std::env::var("AS383_EXP")
+            .map(|v| v.split(',').map(str::to_owned).collect())
+            .unwrap_or_default()
+    })
+    .iter()
+    .any(|v| v == name)
+}
+
+/// AS-383 EXPERIMENT (throwaway): whether a live `TeamPlan` scream dip is cut
+/// to PRESSURED. `dipcut_tgt`: the dip target targets the Priest from within
+/// `threat_intent_radius` (the old false pressure's onset, for the dip only).
+/// `dipcut_cc`: the Priest stands inside the outer disc of a ready hard CC
+/// whose source is not the dip target.
+fn as383_dip_cut(
+    entity: Entity,
+    my_pos: Vec3,
+    target: Option<Entity>,
+    ctx: &CombatContext,
+    abilities: &AbilityDefinitions,
+    shared: &SharedMovementConfig,
+) -> bool {
+    let t = target.and_then(|t| ctx.combatants.get(&t));
+    if as383_exp("dipcut_tgt")
+        && t.is_some_and(|t| {
+            t.target == Some(entity) && t.position.distance(my_pos) <= shared.threat_intent_radius
+        })
+    {
+        return true;
+    }
+    if as383_exp("dipcut_cc") {
+        let field = super::cc_reach::CcField::for_healer(
+            ctx,
+            abilities,
+            entity,
+            shared.cc_ready_horizon,
+            shared.cc_reach_margin,
+        )
+        .without_source(target);
+        let me = Vec2::new(my_pos.x, my_pos.z);
+        if field
+            .covering(ctx.obstacles, me, super::cc_reach::Disc::Outer)
+            .next()
+            .is_some()
+        {
+            return true;
+        }
+    }
+    false
+}
+
+/// AS-383 EXPERIMENT (throwaway): whether a `TeamPlan` scream dip on `target`
+/// may start. `nodip`: never. `dipgate_tgt`: not while the dip target targets
+/// the Priest from within `threat_intent_radius` (what the old false pressure
+/// blocked). `dipgate_cc`: not when the arrival spot (scream radius short of
+/// the target, on the line from it) is inside a ready hard-CC disc.
+fn as383_dip_allowed(
+    entity: Entity,
+    my_pos: Vec3,
+    target: Entity,
+    ctx: &CombatContext,
+    abilities: &AbilityDefinitions,
+    shared: &SharedMovementConfig,
+) -> bool {
+    if as383_exp("nodip") {
+        return false;
+    }
+    let Some(t) = ctx.combatants.get(&target) else {
+        return true;
+    };
+    if as383_exp("dipgate_tgt")
+        && t.target == Some(entity)
+        && t.position.distance(my_pos) <= shared.threat_intent_radius
+    {
+        return false;
+    }
+    if as383_exp("dipgate_cc") {
+        let field = super::cc_reach::CcField::for_healer(
+            ctx,
+            abilities,
+            entity,
+            shared.cc_ready_horizon,
+            shared.cc_reach_margin,
+        )
+        .without_source(Some(target));
+        let tp = Vec2::new(t.position.x, t.position.z);
+        let me = Vec2::new(my_pos.x, my_pos.z);
+        let radius = abilities.get_unchecked(&AbilityType::PsychicScream).range;
+        let arrive = tp + (me - tp).normalize_or_zero() * (radius - 1.0);
+        if field
+            .covering(ctx.obstacles, arrive, super::cc_reach::Disc::Outer)
+            .next()
+            .is_some()
+        {
+            return false;
+        }
+    }
+    if as383_exp("dipgate_path") {
+        let field = super::cc_reach::CcField::for_healer(
+            ctx,
+            abilities,
+            entity,
+            shared.cc_ready_horizon,
+            shared.cc_reach_margin,
+        )
+        .without_source(Some(target));
+        let tp = Vec2::new(t.position.x, t.position.z);
+        let me = Vec2::new(my_pos.x, my_pos.z);
+        let radius = abilities.get_unchecked(&AbilityType::PsychicScream).range;
+        let arrive = tp + (me - tp).normalize_or_zero() * (radius - 1.0);
+        let steps = (me.distance(arrive) / 2.0).ceil().max(1.0) as usize;
+        for i in 0..=steps {
+            let p = me.lerp(arrive, i as f32 / steps as f32);
+            if field
+                .covering(ctx.obstacles, p, super::cc_reach::Disc::Outer)
+                .next()
+                .is_some()
+            {
+                return false;
+            }
+        }
+    }
+    true
+}
