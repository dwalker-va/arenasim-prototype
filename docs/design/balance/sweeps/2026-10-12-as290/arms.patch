+
+// ---------------------------------------------------------------------------
+// Context gates
+// ---------------------------------------------------------------------------
+
+/// A context the Peel play is switched off in, because it measured negative
+/// there: a peeling class, narrowed to one of its tools, to one class of
+/// teammate it peels FOR (the teammate in danger), or both. `None` is "any".
+/// Not every behaviour suits every composition, so the play is kept where it
+/// helps and switched off, by name, where it hurts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PeelContext {
+    /// The class that would peel.
+    pub peeler: CharacterClass,
+    /// The tool it would peel with; `None` for every tool.
+    pub tool: Option<AbilityType>,
+    /// The class of the teammate in danger; `None` for every teammate.
+    pub ally: Option<CharacterClass>,
+}
+
+impl PeelContext {
+    /// Whether this context takes `tool` from a `peeler` peeling for an `ally`.
+    pub fn covers(&self, peeler: CharacterClass, tool: AbilityType, ally: CharacterClass) -> bool {
+        self.peeler == peeler
+            && self.tool.is_none_or(|t| t == tool)
+            && self.ally.is_none_or(|a| a == ally)
+    }
+}
+
+/// One named exception to the Peel play: the context, and the measurement
+/// that put it there.
+#[derive(Clone, Copy, Debug)]
+pub struct PeelGate {
+    pub context: PeelContext,
+    /// One line: what the measurement read, and where it is recorded.
+    pub measured: &'static str,
+}
+
+/// Every context the Peel play is switched off in. Each entry is a deliberate,
+/// measured exception, re-checked at every milestone sweep
+/// (`docs/design/balance/2026-10-12-as274-peel-play.md`, *Graduate or
+/// delete*): it stays only while it still measures negative, and a context
+/// that turns negative joins it. `tests/peel_gates.rs` names them by set
+/// equality, so adding or removing one is a visible edit there too.
+pub const PEEL_GATES: &[PeelGate] = &[];
+
+/// Whether [`PEEL_GATES`] takes `tool` from a `peeler` peeling for `ally`.
+pub fn gated(peeler: CharacterClass, tool: AbilityType, ally: CharacterClass) -> bool {
+    // ARM-ONLY (AS-290 measurement): AS290_PEEL_GATES overrides the table.
+    if let Some(over) = arm_override() {
+        return over.iter().any(|g| g.covers(peeler, tool, ally));
+    }
+    PEEL_GATES
+        .iter()
+        .any(|g| g.context.covers(peeler, tool, ally))
+}
+
+// ARM-ONLY (AS-290 measurement): "Mage:Polymorph@Hunter;Shaman" -> contexts.
+fn arm_override() -> Option<&'static Vec<PeelContext>> {
+    static OVER: std::sync::OnceLock<Option<Vec<PeelContext>>> = std::sync::OnceLock::new();
+    OVER.get_or_init(|| {
+        let raw = std::env::var("AS290_PEEL_GATES").ok()?;
+        let class = |s: &str| {
+            CharacterClass::all()
+                .iter()
+                .copied()
+                .find(|c| format!("{c:?}") == s)
+                .unwrap_or_else(|| panic!("AS290_PEEL_GATES: unknown class {s}"))
+        };
+        Some(
+            raw.split(';')
+                .filter(|s| !s.is_empty())
+                .map(|item| {
+                    let (rest, ally) = match item.split_once('@') {
+                        Some((r, a)) => (r, Some(class(a))),
+                        None => (item, None),
+                    };
+                    let (peeler, tool) = match rest.split_once(':') {
+                        Some((c, t)) => {
+                            let c = class(c);
+                            let tool = peel_tools(c)
+                                .iter()
+                                .copied()
+                                .find(|a| format!("{a:?}") == t)
+                                .unwrap_or_else(|| panic!("AS290_PEEL_GATES: unknown tool {t}"));
+                            (c, Some(tool))
+                        }
+                        None => (class(rest), None),
+                    };
+                    PeelContext { peeler, tool, ally }
+                })
+                .collect(),
+        )
+    })
+    .as_ref()
+}
+
+/// The tools a `peeler` peels with for an `ally` once its gates apply:
+/// [`peel_tools`] less every tool a [`PEEL_GATES`] entry takes, in the same
+/// order.
+pub fn enabled_peel_tools(
+    peeler: CharacterClass,
+    ally: CharacterClass,
+) -> SmallVec<[AbilityType; 2]> {
+    peel_tools(peeler)
+        .iter()
+        .copied()
+        .filter(|&tool| !gated(peeler, tool, ally))
+        .collect()
+}
+
+/// [`enabled_peel_tools`] for the deciding unit peeling for `ally`; none when
+/// either is not in its view.
+pub fn enabled_tools(ctx: &CombatContext, ally: Entity) -> SmallVec<[AbilityType; 2]> {
+    let class = |e: Entity| ctx.combatants.get(&e).map(|info| info.class);
+    match (class(ctx.self_entity), class(ally)) {
+        (Some(peeler), Some(ally)) => enabled_peel_tools(peeler, ally),
+        _ => SmallVec::new(),
+    }
+}
