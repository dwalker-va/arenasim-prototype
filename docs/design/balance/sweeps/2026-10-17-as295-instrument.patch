 const CONCUSSIVE_REFRESH_WINDOW: f32 = 1.0;
 
+/// AS-295 measurement instrument (stderr only; never read by the sim).
+pub mod as295 {
+    use bevy::prelude::Entity;
+    use std::cell::{Cell, RefCell};
+    use std::collections::BTreeMap;
+    thread_local! {
+        static PENDING: RefCell<BTreeMap<u64, (&'static str, Option<u64>, f32)>> =
+            const { RefCell::new(BTreeMap::new()) };
+        pub static NOW: Cell<f32> = const { Cell::new(0.0) };
+        pub static PATH: Cell<&'static str> = const { Cell::new("-") };
+        pub static COUNT_TICK: Cell<bool> = const { Cell::new(false) };
+    }
+    /// `AS295_MODE`: `ship` (default), `off` (no route lane: main's
+    /// behaviour), `unseen` (no route lane, and the fallback lane is exempt
+    /// from the sight rule: the pre-AS-281 lane).
+    pub fn mode() -> &'static str {
+        static MODE: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+        match MODE
+            .get_or_init(|| std::env::var("AS295_MODE").unwrap_or_else(|_| "ship".into()))
+            .as_str()
+        {
+            "off" => "off",
+            "unseen" => "unseen",
+            _ => "ship",
+        }
+    }
+    pub fn throw(owner: Entity, path: &'static str, intended: Option<Entity>) {
+        let now = NOW.with(|n| n.get());
+        eprintln!("AS295 THROW {path}");
+        PENDING.with(|p| {
+            if let Some(old) = p
+                .borrow_mut()
+                .insert(owner.to_bits(), (path, intended.map(|e| e.to_bits()), now))
+            {
+                eprintln!("AS295 OUTCOME {} replaced - - -", old.0);
+            }
+        });
+    }
+    pub fn outcome(owner: Entity, what: &str, victim: Option<Entity>, victim_name: &str) {
+        let now = NOW.with(|n| n.get());
+        PENDING.with(|p| {
+            if let Some((path, intended, at)) = p.borrow_mut().remove(&owner.to_bits()) {
+                let on = match (intended, victim) {
+                    (Some(i), Some(v)) if i == v.to_bits() => "intended",
+                    (_, Some(_)) => "other",
+                    _ => "-",
+                };
+                eprintln!(
+                    "AS295 OUTCOME {path} {what} {on} {:.2} {}",
+                    now - at,
+                    victim_name.replace(' ', "_")
+                );
+            }
+        });
+    }
+    pub fn tick(what: &str) {
+        if COUNT_TICK.with(|c| c.get()) {
+            eprintln!("AS295 TICK {what}");
+        }
+    }
+}
