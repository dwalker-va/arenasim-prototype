+//! AS-292 measurement arm (throwaway): plays a seed bank with the
+//! `as292_instrument` hook on, writing each match's decision trace and the
+//! instrument's pressure lines under `$AS292_DIR`. Reduced by
+//! `docs/design/balance/sweeps/2026-10-17-as292-reduce.py`.
+
+mod common;
+
+use arenasim::headless::HeadlessMatchConfig;
+use common::staged::play_seeded;
+
+const COMPS: &[(&[&str], &[&str])] = &[
+    (&["Mage", "Priest"], &["Warrior", "Druid"]),
+    (&["Warlock", "Shaman"], &["Rogue", "Priest"]),
+    (&["Hunter", "Paladin"], &["Warrior", "Mage"]),
+    (&["Rogue", "Druid"], &["Hunter", "Priest"]),
+    (&["Warrior", "Shaman"], &["Rogue", "Warlock"]),
+    (&["Paladin", "Mage"], &["Warrior", "Hunter"]),
+    (&["Warrior", "Druid"], &["Hunter", "Shaman"]),
+    (&["Warlock", "Priest"], &["Mage", "Shaman"]),
+    (&["Hunter", "Druid"], &["Warlock", "Priest"]),
+];
+const MAPS: &[&str] = &["PillaredArena", "BasicArena"];
+const PROFILES: &[&str] = &["Legacy", "TeamPlan"];
+
+#[test]
+#[ignore = "measurement arm"]
+fn as292_bank() {
+    let dir = std::env::var("AS292_DIR").expect("AS292_DIR");
+    let seeds: u64 = std::env::var("AS292_SEEDS").map_or(12, |s| s.parse().unwrap());
+    std::fs::create_dir_all(&dir).unwrap();
+    for profile in PROFILES {
+        for map in MAPS {
+            for (ci, (team1, team2)) in COMPS.iter().enumerate() {
+                for seed in 1..=seeds {
+                    let stem = format!("{dir}/{profile}_{map}_{ci}_{seed}");
+                    let press = format!("{stem}.press.log");
+                    let _ = std::fs::remove_file(&press);
+                    std::env::set_var("AS292_LOG", &press);
+                    let played = play_seeded(HeadlessMatchConfig {
+                        team1: team1.iter().map(|s| s.to_string()).collect(),
+                        team2: team2.iter().map(|s| s.to_string()).collect(),
+                        map: map.to_string(),
+                        random_seed: Some(seed),
+                        ai_profile: Some(profile.to_string()),
+                        ..Default::default()
+                    });
+                    std::fs::write(format!("{stem}.trace.jsonl"), &played.trace_raw).unwrap();
+                    std::fs::write(
+                        format!("{stem}.result"),
+                        format!(
+                            "{:?} {:?} {:.3}\n",
+                            played.result.winner, played.result.end_reason, played.result.match_time
+                        ),
+                    )
+                    .unwrap();
+                }
+            }
+        }
+    }
+    std::env::remove_var("AS292_LOG");
+}
