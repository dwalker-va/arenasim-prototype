+/// AS-292 measurement instrument (throwaway). For every ally the old rule
+/// pressures (hold or onset), one line to `$AS292_LOG`: which branches of the
+/// test hold it. `prox` within danger_radius; `mp` a melee or pet within the
+/// intent radius; `ch`/`cd` closing within the intent radius by a healer /
+/// a non-healer; `och`/`ocd` the same for the onset's widened band.
+fn as292_instrument(
+    roster: &BTreeMap<Entity, CombatantInfo>,
+    auras: &BTreeMap<Entity, Vec<Aura>>,
+    allies: &[AllyStanding],
+    team: u8,
+    now: f32,
+    cfg: &SituationConfig,
+) {
+    let Ok(path) = std::env::var("AS292_LOG") else {
+        return;
+    };
+    use std::io::Write;
+    let mut out = String::new();
+    for a in allies.iter().filter(|a| a.pressured || a.pressure_onset) {
+        let Some(subject) = roster.get(&a.entity) else {
+            continue;
+        };
+        let m = cfg.danger_edge_margin;
+        let (mut prox, mut mp, mut ch, mut cd, mut och, mut ocd) =
+            (false, false, false, false, false, false);
+        for t in pressure_threats(roster, auras, subject, cfg) {
+            let d = subject.position.distance(t.position);
+            let healer = t.pet_type.is_none() && t.class.is_healer();
+            if d <= cfg.danger_radius {
+                prox = true;
+            }
+            if d <= cfg.threat_intent_radius && (t.is_pet || t.class.is_melee()) {
+                mp = true;
+            }
+            if d <= cfg.threat_intent_radius
+                && !t.is_pet
+                && !t.class.is_melee()
+                && closing(t, subject)
+            {
+                if healer {
+                    ch = true;
+                } else {
+                    cd = true;
+                }
+            }
+            if d <= cfg.threat_intent_radius - m
+                && !t.is_pet
+                && !t.class.is_melee()
+                && t.distance_to(subject.position) > preferred_range(t) + m
+            {
+                if healer {
+                    och = true;
+                } else {
+                    ocd = true;
+                }
+            }
+        }
+        out.push_str(&format!(
+            "{now:.4} {team} {} {:?} dying={} p={} on={} prox={prox} mp={mp} ch={ch} cd={cd} och={och} ocd={ocd} prof={}\n",
+            a.entity.index(),
+            subject.class,
+            a.dying as u8,
+            a.pressured as u8,
+            a.pressure_onset as u8,
+            if cfg.runs == PlaySet::default() { "L" } else { "T" },
+        ));
+    }
+    if !out.is_empty() {
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = f.write_all(out.as_bytes());
+        }
+    }
+}
+
 /// [`AllyStanding::pressured`], judged from `subject`'s own view: the enemies
 /// [`stealth_visible`] lets IT see, its own Shadow Sight included. Enemy pets
 /// count as threats.
