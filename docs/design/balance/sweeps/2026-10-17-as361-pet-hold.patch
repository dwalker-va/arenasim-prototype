+/// AS-361 measurement instrument (stderr only). `AS361_PET_HOLD`: `off`
+/// (default, the branch), `route` (a route-lane throw decided on a pet is
+/// held), `all` (any fallback lane throw decided on a pet is held).
+pub mod as361 {
+    pub fn mode() -> &'static str {
+        static MODE: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+        match MODE
+            .get_or_init(|| std::env::var("AS361_PET_HOLD").unwrap_or_else(|_| "off".into()))
+            .as_str()
+        {
+            "route" => "route",
+            "all" => "all",
+            _ => "off",
+        }
+    }
+}
