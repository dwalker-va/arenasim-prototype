# ------------------------------------------------------------- WARLOCK
click slot:t1s0:change
click class:Warlock
click slot:t1s0
assert-state ViewCombatant

hover kit:Corruption
assert-note tooltip:Ability(Corruption)

hover strategic:CurseOfTongues:e0
assert-note tooltip:Ability(CurseOfTongues)

click kit:Corruption
assert-state Encyclopedia
assert-view Ability(Corruption)

# The encyclopedia's own navigation cluster, while we are here: Back is dead at
# the root of a deep link (the whole point of open_at), and Home names the
# screen that opened it.
assert-enabled enc:back false
assert-visible enc:home
click enc:home
assert-state ViewCombatant
assert-visible kit:Corruption

key Escape
assert-state ConfigureMatch
dump
