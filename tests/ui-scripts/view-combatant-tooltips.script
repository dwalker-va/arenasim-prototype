# ------------------------------------------------------------- PALADIN
click slot:t1s0:change
click class:Paladin
click slot:t1s0
assert-state ViewCombatant

hover kit:HolyShock
assert-note tooltip:Ability(HolyShock)

hover strategic:ConcentrationAura
assert-note tooltip:Ability(ConcentrationAura)

