click slot:t1s0
assert-state ViewCombatant

hover kit:Frostbolt
assert-note tooltip:Ability(Frostbolt)

hover strategic:MoltenArmor
assert-note tooltip:Ability(MoltenArmor)

click kit:Frostbolt
assert-state Encyclopedia
assert-view Ability(Frostbolt)
key Escape
assert-state ViewCombatant
assert-visible kit:Frostbolt

