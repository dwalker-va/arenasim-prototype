# The talent panel: spend points in Custom Match, follow a talent's
# encyclopedia deep link, and come back to the same build.
#
# Run:  cargo run --release -- --ui-script tests/ui-scripts/talent-panel.script
#
#   1. a Warlock in team 1's first slot, its View Combatant sheet open;
#   2. tier 2 is locked until two points are spent in Demonology;
#   3. three clicks learn three ranks, and the panel names the spec;
#   4. the tier-2 node opens and takes a rank;
#   5. shift-click takes a rank back (the driver holds Shift across the
#      press at Bevy's input layer), and a click learns it again;
#   6. right-click a node -> the encyclopedia, on that talent's page;
#   7. Esc -> back on View Combatant, the build still spent;
#   8. Esc -> Configure Match, whose slot row reads the spec;
#   9. Reset clears the build, and the slot reads its class again;
#  10. Affliction's Curse of Exhaustion adds a fourth curse tile, which goes
#      away when the talent is taken back;
#  11. the slot made a Rogue: Assassination's Master Poisoner adds an
#      off-hand poison choice, every poison but the main hand's, which goes
#      away when the talent is taken back;
#  12. the slot a Warlock again, one point back, a match started: the
#      Warlock's team frame names the spec (awaited on the frame's own note,
#      not a frame count).
#
# The Warlock's trees read Affliction first, so a Demonology build's
# shorthand is "0/N"; the Rogue's read Assassination first.
#
# Every wait is the driver's own (hover settles on egui's tooltip gate, a
# click on the click): there is no frame count here.

assert-state MainMenu
click menu:MATCH
assert-state ConfigureMatch

click slot:t1s0
click class:Warlock
click slot:t1s0
assert-state ViewCombatant

# Nothing spent: tier 1 open, tier 2 locked.
assert-note talents:t1s0 points=0
assert-enabled talent:DemonicEmbrace true
assert-enabled talent:UnholyPower false

hover talent:UnholyPower
assert-note tooltip:Talent(UnholyPower)

# Spend three points in tier 1.
click talent:DemonicEmbrace
assert-note talents:t1s0 points=1 spec=Demonology Warlock 0/1
click talent:DemonicEmbrace
click talent:FelStamina
assert-note talents:t1s0 points=3 spec=Demonology Warlock 0/3

# Two points in the tiers above open tier 2.
assert-enabled talent:UnholyPower true
click talent:UnholyPower
assert-note talents:t1s0 points=4 spec=Demonology Warlock 0/4

# A maxed node takes no more.
assert-enabled talent:DemonicEmbrace false

# Shift-click takes a rank back; a plain click learns it again.
click talent:UnholyPower left shift
assert-note talents:t1s0 points=3 spec=Demonology Warlock 0/3
click talent:UnholyPower
assert-note talents:t1s0 points=4 spec=Demonology Warlock 0/4

# The deep link: right-click opens the talent's page.
click talent:UnholyPower right
assert-state Encyclopedia
assert-view Talent(UnholyPower)

# Back to the same combatant, the build still spent.
key Escape
assert-state ViewCombatant
assert-note talents:t1s0 points=4 spec=Demonology Warlock 0/4

key Escape
assert-state ConfigureMatch
assert-note slot:t1s0 subtitle=Demonology Warlock 0/4

# Reset clears the build, and the slot reads its class again.
click slot:t1s0
assert-state ViewCombatant
click talents:reset
assert-note talents:t1s0 points=0 spec=No talents learned
assert-enabled talents:reset false
key Escape
assert-state ConfigureMatch
assert-note slot:t1s0 subtitle=Shadow magic and curses

# Curse of Exhaustion: a fourth curse tile, only while the talent is learned.
click slot:t1s0
assert-state ViewCombatant
assert-absent strategic:CurseOfExhaustion:e0
click talent:ImprovedDrainLife
click talent:ImprovedDrainLife
click talent:AmplifyCurse
click talent:CurseOfExhaustion
assert-note talents:t1s0 points=4 spec=Affliction Warlock 4/0
assert-enabled strategic:CurseOfExhaustion:e0 true
click talent:CurseOfExhaustion left shift
assert-note talents:t1s0 points=3 spec=Affliction Warlock 3/0
assert-absent strategic:CurseOfExhaustion:e0
click talents:reset
assert-note talents:t1s0 points=0 spec=No talents learned

# Master Poisoner: an off-hand poison choice, only while the talent is
# learned, offering every poison but the main hand's (Crippling, the default).
key Escape
assert-state ConfigureMatch
click slot:t1s0:change
click class:Rogue
click slot:t1s0
assert-state ViewCombatant
assert-absent strategic:DeadlyPoison:offhand
click talent:VilePoisons
click talent:VilePoisons
click talent:MasterPoisoner
assert-note talents:t1s0 points=3 spec=Assassination Rogue 3/0
assert-enabled strategic:DeadlyPoison:offhand true
assert-absent strategic:CripplingPoison:offhand
click talent:MasterPoisoner left shift
assert-note talents:t1s0 points=2 spec=Assassination Rogue 2/0
assert-absent strategic:DeadlyPoison:offhand
click talents:reset
assert-note talents:t1s0 points=0 spec=No talents learned

# Back to the Warlock.
key Escape
assert-state ConfigureMatch
click slot:t1s0:change
click class:Warlock
click slot:t1s0
assert-state ViewCombatant

# A talented match: the Warlock's team frame reads the spec its build names.
click talent:DemonicEmbrace
assert-note talents:t1s0 points=1 spec=Demonology Warlock 0/1
key Escape
assert-state ConfigureMatch
click slot:t2s0
click class:Warrior
assert-enabled configure:start true
click configure:start
assert-state PlayMatch
await-note 30 frame-spec Warlock: Demonology Warlock 0/1
dump
