            slot: MainHand,
            weapon_type: Mace,
            is_weapon: true,
            attack_damage_min: 27.0,
            attack_damage_max: 40.5,
            weapon_speed: 2.7, // Classic: The Hammer of Grace (11923)
            spell_power: 6.0,
        ),

        // A two-hander is priced at what the one-hander + off-hand pair it
        // displaces spends (Witchblade + Tome of Knowledge, 32.5), not at its full-slot cap (43.5): more spell
        // power and a smaller pool than the pair, at the same price.
        // Its weapon DPS is Witchblade's x Classic's two-hander premium, Elemental
        // Mage Staff 57.50 / Witchblade 40.63 = 1.42.
        CrescentStaff: (
            name: "Crescent Staff",
            item_level: 58,
            icon: "icons/items/inv_staff_30.jpg",
            slot: MainHand,
            weapon_type: Staff,
            is_weapon: true,
            two_handed: true,
            attack_damage_min: 45.86,
            attack_damage_max: 76.42,
            weapon_speed: 3.2, // Classic: Elemental Mage Staff (944)
            spell_power: 15.0,
            max_mana: 10.0,
        ),

        // --------------------------------------------------------------------
        // CASTER ONE-HANDERS — the main hand as a stat slot for a caster
        //
        // Mage and Warlock train dagger, one-handed sword, staff and wand, and
        // no mace. Before these, every one-hander either class could hold
        // carried attack power and nothing else, so the only main hand with a
        // caster stat on it was a two-handed staff — which costs them the
        // off-hand. The dagger-plus-tome loadout was unrepresentable, and the
        // staff-versus-one-hander choice was no choice at all.
        //
        // Spent under budget: Witchblade takes 13.5 of an ilvl-58 one-hander's
        // 18.3 points (`ONE_HAND_BUDGET_MULTIPLIER`, 0.42). Each staff is
        // priced at exactly what its one-hander + off-hand pair spends
        // (`two_handers_are_priced_at_the_pair_they_displace`), so raising a
        // one-hander here must move its staff's price with it.
        //
        // The weapon damage here is INERT for the classes these are meant for:
        // `apply_equipment` replaces attack damage from ONE socket, the one
        // `class.weapon_slot()` names, and for a Mage, Warlock or Priest that
        // socket is Ranged. It is carried for the classes whose live socket IS
        // the main hand and that also train daggers, and so the picker reads
        // them as weapons.
        // --------------------------------------------------------------------

        Witchblade: (
            name: "Witchblade",
            item_level: 58,
            icon: "icons/items/inv_weapon_shortblade_25.jpg",
            slot: MainHand,
            weapon_type: Dagger,
            is_weapon: true,
            attack_damage_min: 16.8,
            attack_damage_max: 26.4,
            weapon_speed: 1.6, // Classic: Witchblade (13964)
            spell_power: 5.0,
            max_mana: 6.0,
        ),

