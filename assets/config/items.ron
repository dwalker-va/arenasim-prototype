        // ====================================================================
        // PROC TRINKETS
        //
        // A trigger plus an effect, on this trinket's OWN internal cooldown.
        // The proc is charged to the item budget at its expected value
        // (weight * magnitude * duration/(duration+icd)), so the big burst
        // number buys a small sustained one: Dragonspine's +55 attack power
        // averages +10 AP over a long life, and costs the 15 budget points that
        // averages to. (A short life runs above that — a trinket starts ready.)
        // ====================================================================

        DragonspineTrophy: (
            name: "Dragonspine Trophy",
            item_level: 58,
            icon: "icons/items/inv_misc_bone_06.jpg",
            slot: Trinket,
            attack_power: 4.0,
            proc: Some((
                trigger: MeleeHit,
                rate: PerMinute(9.0),
                effect: AttackPowerIncrease,
                magnitude: 55.0,
                duration: 10.0,
                internal_cooldown: 45.0,
            )),
        ),

