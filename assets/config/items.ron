            )),
        ),

        // ====================================================================
        // MELEE WEAPONS
        // ====================================================================

        // A two-hander is priced at what the one-hander + off-hand pair it
        // displaces spends (Frostbite Blade + Wall of the Dead, 25.5), not at its full-slot cap (45.0): the
        // same points, spent on offense where the pair spends them on a shield.
        // Its weapon DPS is Frostbite Blade's x Classic's two-hander premium at
        // this tier, Arcanite Reaper 53.82 / Dal'Rend's Sacred Charge 41.43 = 1.30.
        ArcaniteReaper: (
            name: "Arcanite Reaper",
            item_level: 60,
            icon: "icons/items/inv_axe_09.jpg",
            slot: MainHand,
            weapon_type: Axe,
            is_weapon: true,
            two_handed: true,
            attack_damage_min: 57.02,
            attack_damage_max: 73.30,
            weapon_speed: 3.8, // Classic: Arcanite Reaper (12784)
            attack_power: 11.0,
            crit_chance: 0.03,
        ),

        FrostbiteBlade: (
            name: "Frostbite Blade",
