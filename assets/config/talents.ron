// Talents: each class's trees and their nodes.
//
// Design: docs/design/proposals/2026-10-11-talents-and-gauntlet.md §3. Loaded
// and validated by `src/states/play_match/talents.rs`, in both modes; a match
// carries one `Build` per combatant (`team1_builds` / `team2_builds`), and an
// empty build — the default — changes nothing.
//
// A node:
//   - sits in its class's tree, at a tier (1-4) and a column (0-2). A tier
//     opens once the tree holds 0 / 2 / 3 / 5 points in the tiers below it.
//   - has `max_rank` ranks (tiers 1-2: one or two; tiers 3-4: one), and
//     applies its `per_rank` effects once per rank. Ranks ADD, for every
//     effect kind: two ranks of +3% are +6%, and two ranks of Mul(1.15) scale
//     by 1.30 (10 -> 11.5 -> 13), never compound.
//       StatPercent(stat, fraction)     a percentage of the combatant's total,
//                                       gear included; for a chance or haste
//                                       every class has at 0 (DodgeChance,
//                                       ParryChance, MeleeAttackSpeed), the
//                                       fraction added in points
//       PetStatPercent(stat, fraction)  the same, on the combatant's pet
//       Patch(on: Ability(X) | School(S), field: <AbilityField>, op: Add(n) | Mul(n))
//                                       rewrites a numeric field of its
//                                       book's configs; adds before multiplies.
//                                       `Damage` is the base range and the
//                                       coefficient together (Mul only)
//       Grant(X)                        adds the `talent: true` ability X
//       Proc((trigger: .., chance: Chance(c) | PerMinute(r), ranks_add: Chance | Effect,
//             effect: ApplyAura(..) | NextCast(..) | HealBack(..)))
//                                       a trigger and an effect on the
//                                       combatant (`talent_procs.rs`); its
//                                       ranks add to its chance or its effect
//       WidenChoice(<Menu>(<Option>))   offers a per-match option that is
//                                       hidden from every build without this
//                                       node (talent_choices.rs)
//       AddChoiceSlot(OffHandPoison)    opens a second slot of a menu
//       Mechanic(<TalentMechanic>)      a bespoke rule with one code site
//                                       (talent_mechanics.rs)
//       FromRank(r, <effect>)           <effect>, once per rank from rank r
//   - `choice_rules: [...]` (top level) makes per-match choices exclusive:
//       SwitchesOff(option: O, talent: T)  O chosen turns T off for the match
//       Forbids(option: O, ability: A)     O chosen locks A
//       Requires(ability: A, option: O)    A is locked unless O is chosen
//   - is priced on the item budget: 11 a rank, 22 the capstone (tier 4),
//     ±15%. A node whose every effect is a StatPercent on a stat the item
//     budget weighs has its price COMPUTED, at the class's reference
//     combatant below, and declares no `budget`; every other node declares
//     its `budget` (per rank).
//   - may `requires: Some((Talent, rank))`, a node of the same tree at a
//     lower tier.
(
    trees: {
        Warlock: [
            (id: Demonology, name: "Demonology", icon: "icons/talents/spell_shadow_metamorphosis.jpg"),
        ],
        Rogue: [
            (id: Combat, name: "Combat", icon: "icons/talents/ability_backstab.jpg"),
        ],
    },

    talents: {
        // ---- Warlock: Demonology ----
        DemonicEmbrace: (
            name: "Demonic Embrace",
            class: Warlock, tree: Demonology, tier: 1, column: 0,
            icon: "icons/talents/spell_shadow_metamorphosis.jpg",
            max_rank: 2,
            // +3% maximum health a rank, gear included: 377 -> 388 -> 400 on
            // the starting kit. Applied before the Felhunter spawns, so its
            // 0.45 share grows with it.
            per_rank: [StatPercent(MaxHealth, 0.03)],
        ),
        FelStamina: (
            name: "Fel Stamina",
            class: Warlock, tree: Demonology, tier: 1, column: 2,
            icon: "icons/talents/spell_shadow_antishadow.jpg",
            max_rank: 2,
            budget: Some(11.0),
            // Felhunter +10% maximum health a rank: 170 -> 187 -> 204.
            per_rank: [PetStatPercent(MaxHealth, 0.10)],
        ),
        UnholyPower: (
            name: "Unholy Power",
            class: Warlock, tree: Demonology, tier: 2, column: 0,
            icon: "icons/talents/spell_shadow_shadowworddominate.jpg",
            max_rank: 2,
            budget: Some(11.0),
            // Felhunter melee +10% a rank.
            per_rank: [PetStatPercent(WeaponDamage, 0.10)],
        ),

        // ---- Rogue: Combat (AS-418) ----
        // The anti-melee specialist: avoidance, melee haste, and a capstone
        // that opens an armored target up. Dodge, parry and melee haste carry
        // no item-budget weight, so their nodes declare a rank's price.
        // Values provisional: tuning is the milestone sweep's (AS-302).
        LightningReflexes: (
            name: "Lightning Reflexes",
            class: Rogue, tree: Combat, tier: 1, column: 0,
            icon: "icons/talents/spell_nature_invisibilty.jpg",
            max_rank: 2,
            budget: Some(11.0),
            // +4% dodge chance a rank, in points: 0 -> 4% -> 8%.
            per_rank: [StatPercent(DodgeChance, 0.04)],
        ),
        DualWieldSpecialization: (
            name: "Dual Wield Specialization",
            class: Rogue, tree: Combat, tier: 1, column: 2,
            icon: "icons/talents/ability_dualwield.jpg",
            max_rank: 2,
            budget: Some(11.0),
            // Off-hand weapon damage +10% a rank.
            per_rank: [StatPercent(OffHandDamage, 0.10)],
        ),
        Aggression: (
            name: "Aggression",
            class: Rogue, tree: Combat, tier: 2, column: 0,
            icon: "icons/talents/ability_racial_avatar.jpg",
            max_rank: 2,
            budget: Some(11.0),
            // Sinister Strike damage +6% a rank.
            per_rank: [Patch(on: Ability(SinisterStrike), field: Damage, op: Mul(1.06))],
        ),
        Vitality: (
            name: "Vitality",
            class: Rogue, tree: Combat, tier: 2, column: 1,
            icon: "icons/talents/ability_warrior_revenge.jpg",
            max_rank: 1,
            // About +2.8% maximum health, gear included: 396 -> 407 at the
            // reference Rogue. Its price is computed there, and the fraction
            // is the one that prices it at exactly a rank (11 / 396): a tree
            // with a capstone holds every legal build within one rank only if
            // each rank costs 11.
            per_rank: [StatPercent(MaxHealth, 0.027778)],
        ),
        Deflection: (
            name: "Deflection",
            class: Rogue, tree: Combat, tier: 2, column: 2,
            icon: "icons/talents/ability_parry.jpg",
            max_rank: 2,
            budget: Some(11.0),
            // +4% parry chance a rank, in points: 0 -> 4% -> 8%. The Rogue is
            // the first class that can parry.
            per_rank: [StatPercent(ParryChance, 0.04)],
        ),
        SwiftBlades: (
            name: "Swift Blades",
            class: Rogue, tree: Combat, tier: 3, column: 1,
            icon: "icons/talents/ability_warrior_punishingblow.jpg",
            max_rank: 1,
            // A declared rank, not `WEIGHT_ATTACK_SPEED` (which prices haste
            // procs on items).
            budget: Some(11.0),
            // +10% melee attack speed: both hands swing 10% faster; a bow or
            // a wand would not.
            per_rank: [StatPercent(MeleeAttackSpeed, 0.10)],
        ),
        ExposeArmor: (
            name: "Expose Armor",
            class: Rogue, tree: Combat, tier: 4, column: 1,
            icon: "icons/talents/ability_warrior_riposte.jpg",
            max_rank: 1,
            budget: Some(22.0),
            requires: Some((SwiftBlades, 1)),
            // Removes 50% of the target's armor for 15s: 25 energy, 20s
            // cooldown.
            per_rank: [Grant(ExposeArmor)],
        ),
    },

    // Each class's reference combatant at mid-run, which prices its computed
    // nodes: the starting kit with three Gauntlet picks in place, named here as
    // the sockets they fill. Until the Gauntlet's reward tables exist (G2),
    // the picks are the class's tier-1 items for the three slots offered most
    // (head, chest, legs: the 1.0 group).
    reference: {
        Warlock: {
            Head: ArcanistCrown,
            Chest: ArcanistRobes,
            Legs: ArcanistLeggings,
        },
        Rogue: {
            Head: DeathdealerCowl,
            Chest: DeathdealerTunic,
            Legs: DeathdealerLegs,
        },
    },
)
