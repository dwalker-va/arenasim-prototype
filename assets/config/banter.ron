// Team Banter Configuration
//
// What each team says when its kill-target call changes. Loaded and validated
// at GRAPHICAL startup only by BanterConfigPlugin
// (src/states/play_match/banter_config.rs); the plugin panics at startup if
// this file is missing, malformed, or fails validation.
//
// Unlike movement.ron, this file is NEVER read in headless mode — banter is
// visual-only, so a malformed pool can never stop a balance sweep and the
// content can never become a sim input.
//
// ===========================================================================
// COMBATANTS DO NOT SPEAK ENGLISH
// ===========================================================================
//
// A line is a short sequence of the game's OWN iconography — ability art and
// team-tinted class portraits — stitched together with symbol glyphs.
// `⚔ ➡ {target}` reads as "attack that one" without belonging to any language,
// and it reads in the visual vocabulary the player already learned from the
// ability bar.
//
// Tokens (see src/states/play_match/banter/vocab.rs for the grammar):
//
//   {target}                 portrait of the called enemy, tinted by ITS team
//   {prev_target}            the replaced target's portrait (Correction only)
//   {speaker}                the speaking combatant's own portrait
//   {ability:Mortal Strike}  that ability's icon, untinted
//
// Portraits are tinted BLUE for team 1 and RED for team 2 — the same colours
// the combat-log timeline uses — so a line pointing at an enemy shows them in
// the enemy's colour and there is no ambiguity about which side is meant.
//
// KNOWN LIMITATION: a portrait names a CLASS, not a combatant. A team fielding
// two of the same class renders the same portrait for both, so a line cannot
// distinguish them. Acceptable for now; the fix would be per-combatant marks.
//
// GLYPHS ARE ALLOWLISTED. egui ships only a subset of emoji, so `→` and `✓`
// render as empty boxes while `➡` and `✔` render fine. Validation rejects any
// character outside the approved set, naming the offender — so a tofu box
// cannot reach a match. The approved set lives in `banter::vocab::GLYPHS`;
// adding to it means first proving the glyph renders.
//
// Vocabulary in play, and what each says in context:
//   ⚔  attack        💀 kill / death     ➡  directs at a target
//   ✖  no / stop     ⛔ hard stop        ⚠  beware
//   ✔  yes / on it   👍 agreed           ❓ uncertainty
//   ❤  healing       🛡 defence          ⚡ burst
//   🎯 spotted       ⏱  timing           ‼  urgency
//   …  hesitation    ★  flourish        ⌛ waiting
//
// Avoid 👀: it technically renders, but as two dots barely visible at bubble
// size. ❓ carries "where is it" and 🎯 carries "spotted" far better.
//
// ===========================================================================
// HOW THE POOL IS TIERED
// ===========================================================================
//
// Coverage is total from day one and deepens by appending, never by filling a
// grid. Four tiers, loosest first:
//
//   1. generic       — any speaker, any target. The floor; always satisfiable.
//   2. by target     — the called class has a specific threat worth naming.
//   3. by speaker    — the caller's own kit colours the line.
//   4. full pair     — speaker AND target, only where a real joke exists.
//
// The resolver WEIGHTS by specificity (specificity_weight per non-Any
// constraint) rather than filtering, so a bespoke line lands often without
// ever crowding the generics out. Adding one is one appended entry.
//
// SILENCE IN 1v1 IS DELIBERATE, AND THE ROLE COUNT ENFORCES IT.
// Every exchange — including the single-beat Switch shouts — declares two
// distinct speaker roles. A solo combatant cannot bind both, so nothing is
// satisfiable and a 1v1 team says nothing, in the countdown AND mid-fight.
// The Switch entries get a silent "witness" role with no beat: someone has to
// be there to hear it.
(
    timing: (
        // ---- PACING -------------------------------------------------------
        // The whole tuning surface for how banter reads. Re-read at startup,
        // so tuning is edit-and-relaunch with no rebuild. If lines feel
        // rushed, raise `line_lifetime` first and `beat_gap` second.
        //
        // Two bounds constrain it. `latest_beat` keeps every beat inside the
        // 10s countdown, and validation rejects a pool where `line_lifetime`
        // minus a context's start delay reaches its beat gap (a deferred beat
        // could then collide with the one behind it).

        // Seconds after the call change before the first beat speaks. Applies
        // to Opening and Correction, both of which play during the countdown
        // while combatants are still settling into the starting room.
        opening_start: 1.5,
        // A mid-fight Switch shout does NOT wait that out — its job is to make
        // the operator's order legible the moment it is given.
        switch_start: 0.8,
        // Seconds between consecutive beats (Opening and Switch). Below
        // `line_lifetime` on purpose: consecutive lines overlap a little so an
        // exchange reads as conversation rather than as a slideshow.
        beat_gap: 3.0,
        // How long each bubble stays up — the read-time knob. Two beats on the
        // same role must be at least this far apart.
        line_lifetime: 3.6,
        // Tighter pacing for corrections — they race the gates.
        correction_beat_gap: 2.4,
        // The countdown is 10s; no beat may start after this.
        latest_beat: 9.0,
        // Selection-weight multiplier per non-Any constraint. 1.0 would make
        // specificity irrelevant; this favours a bespoke exchange without
        // ever crowding the generics out.
        specificity_weight: 3.0,
    ),
    exchanges: [
        // =====================================================================
        // OPENING — the countdown exchange
        // =====================================================================

        // ---- tier 1: generic ------------------------------------------------
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "⚔ ➡ {target}"),
                (role: "responder", text: "✔"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target} ➡ 💀"),
                (role: "responder", text: "👍"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target} ❓"),
                (role: "responder", text: "{target} ‼"),
                (role: "caller",    text: "⚔"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "⚔ ➡ {target} ⏱"),
                (role: "responder", text: "⌛ …"),
                (role: "caller",    text: "‼"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{speaker} ⚔ ➡ {target}"),
                (role: "responder", text: "★ ✔"),
            ],
        ),

        // ---- tier 2: by target ----------------------------------------------
        // The healer dies first, and everyone knows why.
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Priest),
            beats: [
                (role: "caller",    text: "{target} ❤ ✖"),
                (role: "responder", text: "⚔ ➡ {target} ‼"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Paladin),
            beats: [
                (role: "caller",    text: "⚔ ➡ {target}"),
                (role: "responder", text: "{ability:Divine Shield} ⚠ ⏱"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Shaman),
            beats: [
                (role: "caller",    text: "{target} ➡ 💀"),
                (role: "responder", text: "{ability:Windfury Totem} ✖ ⚔"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Rogue),
            beats: [
                (role: "caller",    text: "⚔ ➡ {target}"),
                (role: "responder", text: "❓ ❓ …"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Mage),
            beats: [
                (role: "caller",    text: "{target} ➡ 💀 ⏱"),
                (role: "responder", text: "{ability:Polymorph} ⚠"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Warlock),
            beats: [
                (role: "caller",    text: "{target} ⏱ ‼"),
                (role: "responder", text: "{ability:Corruption} ⚠"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Warrior),
            beats: [
                (role: "caller",    text: "⚔ ➡ {target}"),
                (role: "responder", text: "{ability:Charge} ⚠ 🛡"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Hunter),
            beats: [
                (role: "caller",    text: "{target} ➡ 💀"),
                (role: "responder", text: "{ability:Freezing Trap} ⚠ 🎯"),
            ],
        ),

        // ---- tier 3: by speaker ---------------------------------------------
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Rogue)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{ability:Ambush} ➡ {target}"),
                (role: "responder", text: "❓ …"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Warrior)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{ability:Charge} ➡ {target}"),
                (role: "responder", text: "★"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Class(Priest)) ],
            target: Any,
            beats: [
                (role: "caller",    text: "⚔ ➡ {target} ❤ ❓"),
                (role: "responder", text: "{ability:Flash Heal} ✔"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Class(Paladin)) ],
            target: Any,
            beats: [
                (role: "caller",    text: "⚔ ➡ {target} ‼"),
                (role: "responder", text: "🛡 ✔"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Hunter)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{ability:Aimed Shot} ➡ {target}"),
                (role: "responder", text: "🎯 👍"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Warlock)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{ability:Corruption} ➡ {target}"),
                (role: "responder", text: "⌛ ✔"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Mage)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "❄ ➡ {target}"),
                (role: "responder", text: "✔"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Shaman)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "⚡ ➡ {target}"),
                (role: "responder", text: "👍"),
            ],
        ),

        // ---- tier 4: full pairs ---------------------------------------------
        // A Rogue promising to open on a healer, and the healer's own class
        // knowing exactly how that goes.
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Rogue)), (role: "responder", class: Any) ],
            target: Class(Priest),
            beats: [
                (role: "caller",    text: "{ability:Cheap Shot} ➡ {target}"),
                (role: "responder", text: "{target} ❤ ⛔ ★"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Mage)), (role: "responder", class: Any) ],
            target: Class(Warrior),
            beats: [
                (role: "caller",    text: "{ability:Frost Nova} ➡ {target} ★"),
                (role: "responder", text: "{ability:Berserker Rage} ⚠ …"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Warrior)), (role: "responder", class: Any) ],
            target: Class(Mage),
            beats: [
                (role: "caller",    text: "{ability:Charge} ➡ {target} 💀"),
                (role: "responder", text: "{ability:Ice Barrier} ⚠ ❓"),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Priest)), (role: "responder", class: Any) ],
            target: Class(Paladin),
            beats: [
                (role: "caller",    text: "{speaker} ❤ ⚔ {target} ❤"),
                (role: "responder", text: "⌛ ⌛ …"),
            ],
        ),

        // =====================================================================
        // CORRECTION — the call changed before the gates
        // =====================================================================

        // ---- tier 1: generic ------------------------------------------------
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "✖ {prev_target} ➡ {target}"),
                (role: "responder", text: "✔"),
            ],
        ),
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "⛔ ‼ {target}"),
                (role: "responder", text: "{prev_target} ❓"),
                (role: "caller",    text: "{target} ‼"),
            ],
        ),
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target} ⚔"),
                (role: "responder", text: "… {prev_target} ❓ ⁉"),
            ],
        ),
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "✖ ✖ {target} ‼"),
                (role: "responder", text: "⏱ ⛔ 👍"),
            ],
        ),

        // ---- tier 2: by target ----------------------------------------------
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Priest),
            beats: [
                (role: "caller",    text: "✖ {prev_target} ➡ {target} ❤"),
                (role: "responder", text: "★ ✔"),
            ],
        ),
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Rogue),
            beats: [
                (role: "caller",    text: "❓ ‼ {target}"),
                (role: "responder", text: "❓ ❓"),
                (role: "caller",    text: "…"),
            ],
        ),

        // =====================================================================
        // SWITCH — the call changed after the gates
        //
        // One spoken beat (R8), but TWO declared roles: the silent "witness"
        // has no line and exists solely so a solo combatant cannot satisfy the
        // exchange. That is what keeps 1v1 quiet mid-fight.
        // =====================================================================

        // ---- tier 1: generic ------------------------------------------------
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Any,
            beats: [ (role: "caller", text: "‼ ➡ {target}") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Any,
            beats: [ (role: "caller", text: "⚔ {target} ‼") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Any,
            beats: [ (role: "caller", text: "{target} ➡ 💀 ‼") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Any,
            beats: [ (role: "caller", text: "⛔ ➡ {target}") ],
        ),

        // ---- tier 2: by target ----------------------------------------------
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Class(Priest),
            beats: [ (role: "caller", text: "{target} ❤ ⛔ ‼") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Class(Mage),
            beats: [ (role: "caller", text: "{target} 🎯 ‼ ⚔") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Class(Rogue),
            beats: [ (role: "caller", text: "❓ ‼ {target}") ],
        ),
    ],
)
