// Team Banter Configuration
//
// What each team says when its kill-target call changes. Loaded and validated
// at GRAPHICAL startup only by BanterConfigPlugin
// (src/states/play_match/banter_config.rs); the plugin panics at startup if
// this file is missing, malformed, or fails validation.
//
// Unlike movement.ron, this file is NEVER read in headless mode — banter is
// visual-only, so a malformed pool can never stop a balance sweep and the
// content can never become a sim input.
//
// Missing fields fall back to the struct defaults in banter_config.rs; the
// timing block is stated explicitly here anyway so this file is the single
// place pacing is tuned.
//
// The authored unit is a whole EXCHANGE, not a line: setup and punchline are
// written together, so the resolver can never staple a reply onto an opener
// it was not written for. Each exchange declares the roles it needs (with an
// optional class requirement) and an optional requirement on the called
// target's class; the resolver keeps the exchanges the lineup satisfies,
// favours the more specific ones without excluding the generics, and picks
// deterministically from the match seed.
//
// Beat times are DERIVED, never authored: beat i starts at
// opening_start + i * beat_gap (correction_beat_gap in the Correction
// context). Validation rejects a pool where two beats on ONE role land
// within line_lifetime of each other (bubbles have no per-owner offset, so
// they would draw on top of each other) or where any beat starts after
// latest_beat. Practical consequence: never put two CONSECUTIVE beats on the
// same role — alternate speakers.
//
// Substitution: {target} is the called target's class in every context;
// {prev_target} is the replaced target's class and is available in the
// Correction context only. An unresolvable placeholder renders as "them".
//
// COVERAGE FLOOR: every context (Opening, Correction, Switch) must carry at
// least one FULLY GENERIC exchange — all speaker classes Any and target Any —
// so resolution can never come up empty. Validation enforces this.
//
// ---------------------------------------------------------------------------
// HOW THE POOL IS TIERED
//
// Coverage is total from day one and deepens by appending, never by filling a
// grid. Four tiers, loosest first:
//
//   1. generic       — any speaker, any target. The floor; always satisfiable.
//   2. by target     — the called class has a specific joke against it.
//   3. by speaker    — the caller's own class colours the line.
//   4. full pair     — speaker AND target, written only where a real joke exists.
//
// The resolver WEIGHTS by specificity (specificity_weight per non-Any
// constraint) rather than filtering, so a bespoke line lands often without
// ever crowding the generics out. Adding a joke is one appended entry.
//
// SILENCE IN 1v1 IS DELIBERATE, AND IT IS THE ROLE COUNT THAT ENFORCES IT.
// Every exchange here — including the single-beat Switch shouts — declares two
// distinct speaker roles. A solo combatant cannot bind both, so nothing is
// satisfiable and a 1v1 team says nothing, in the countdown AND mid-fight.
// A lone fighter announcing a target to an empty arena is the same noise the
// pre-gate ability-bubble cleanup exists to remove. The Switch entries get a
// silent "witness" role with no beat: someone has to be there to hear it.
// ---------------------------------------------------------------------------
(
    timing: (
        // Seconds after the call change before the first beat speaks.
        opening_start: 2.0,
        // Seconds between consecutive beats (Opening and Switch).
        beat_gap: 2.2,
        // How long each bubble stays up. Two beats on the same role must be
        // at least this far apart.
        line_lifetime: 2.6,
        // Tighter pacing for corrections — they race the gates.
        correction_beat_gap: 1.6,
        // The countdown is 10s; no beat may start after this.
        latest_beat: 9.0,
        // Selection-weight multiplier per non-Any constraint. 1.0 would make
        // specificity irrelevant; this favours a bespoke exchange without
        // ever crowding the generics out.
        specificity_weight: 3.0,
    ),
    exchanges: [
        // =====================================================================
        // OPENING — the countdown exchange
        // =====================================================================

        // ---- tier 1: generic ------------------------------------------------
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target} dies first."),
                (role: "responder", text: "Working on it."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "Kill the {target}."),
                (role: "responder", text: "Say when."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "We go {target}. Everything on it."),
                (role: "responder", text: "Everything."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "So. The {target}."),
                (role: "responder", text: "The {target}."),
                (role: "caller",    text: "Glad we talked."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "Anyone object to the {target}?"),
                (role: "responder", text: "Gates are opening."),
                (role: "caller",    text: "That's not a no."),
            ],
        ),

        // ---- tier 2: by target ----------------------------------------------
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Priest),
            beats: [
                (role: "caller",    text: "The Priest. Nothing else dies until it does."),
                (role: "responder", text: "Then let's get it over with."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Paladin),
            beats: [
                (role: "caller",    text: "Paladin first. Save something for the bubble."),
                (role: "responder", text: "I always do."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Shaman),
            beats: [
                (role: "caller",    text: "The Shaman. And its little totems too."),
                (role: "responder", text: "You've been waiting to say that."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Rogue),
            beats: [
                (role: "caller",    text: "The Rogue. The moment it shows itself."),
                (role: "responder", text: "That's the hard part, isn't it."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Mage),
            beats: [
                (role: "caller",    text: "The Mage. Before it gets comfortable."),
                (role: "responder", text: "Sheep me and I'm blaming you."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Warlock),
            beats: [
                (role: "caller",    text: "Warlock. Kill it before the dots land."),
                (role: "responder", text: "Optimistic."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Warrior),
            beats: [
                (role: "caller",    text: "The Warrior. Take its legs."),
                (role: "responder", text: "I'll take its funeral."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Hunter),
            beats: [
                (role: "caller",    text: "The Hunter. Ignore the pet."),
                (role: "responder", text: "The pet has opinions about that."),
            ],
        ),

        // ---- tier 3: by speaker ---------------------------------------------
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Rogue)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "I'll open on the {target}."),
                (role: "responder", text: "Try not to die in stealth this time."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Warrior)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target}. I'm charging."),
                (role: "responder", text: "You're always charging."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Class(Priest)) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target}. Keep me standing."),
                (role: "responder", text: "Keep yourself standing. I'll help."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Class(Paladin)) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target}. This is going to get loud."),
                (role: "responder", text: "It always gets loud."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Hunter)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target}. I'm trapping the rest."),
                (role: "responder", text: "Show off."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Warlock)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target}. Everything else gets feared."),
                (role: "responder", text: "Charming."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Mage)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "{target}. I'll slow everything that isn't it."),
                (role: "responder", text: "Good."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Shaman)), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "Totems are down. {target}."),
                (role: "responder", text: "Understood."),
            ],
        ),

        // ---- tier 4: full pairs ---------------------------------------------
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Warrior)), (role: "responder", class: Any) ],
            target: Class(Mage),
            beats: [
                (role: "caller",    text: "The Mage. It can't blink through me."),
                (role: "responder", text: "It can absolutely blink through you."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Rogue)), (role: "responder", class: Any) ],
            target: Class(Priest),
            beats: [
                (role: "caller",    text: "Priest. It won't see me coming."),
                (role: "responder", text: "It never does."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Hunter)), (role: "responder", class: Any) ],
            target: Class(Rogue),
            beats: [
                (role: "caller",    text: "The Rogue. My pet can smell it."),
                (role: "responder", text: "Disgusting. Effective."),
            ],
        ),
        (
            context: Opening,
            speakers: [ (role: "caller", class: Class(Priest)), (role: "responder", class: Any) ],
            target: Class(Paladin),
            beats: [
                (role: "caller",    text: "The Paladin. Healer against healer."),
                (role: "responder", text: "This is going to take a while."),
            ],
        ),

        // =====================================================================
        // CORRECTION — the call changed before the gates
        // =====================================================================

        // ---- tier 1: generic ------------------------------------------------
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "Belay that. {target}, not the {prev_target}."),
                (role: "responder", text: "{target} it is."),
            ],
        ),
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "Change of plan — {target}."),
                (role: "responder", text: "Forget the {prev_target}, got it."),
            ],
        ),
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "Actually, the {target}."),
                (role: "responder", text: "You said {prev_target} ten seconds ago."),
                (role: "caller",    text: "And now I'm saying {target}."),
            ],
        ),
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Any,
            beats: [
                (role: "caller",    text: "Not the {prev_target}. The {target}."),
                (role: "responder", text: "Gates are literally opening."),
            ],
        ),

        // ---- tier 2: by target ----------------------------------------------
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Priest),
            beats: [
                (role: "caller",    text: "New call — the Priest."),
                (role: "responder", text: "We should have started there."),
            ],
        ),
        (
            context: Correction,
            speakers: [ (role: "caller", class: Any), (role: "responder", class: Any) ],
            target: Class(Rogue),
            beats: [
                (role: "caller",    text: "Forget the {prev_target}. The Rogue just moved."),
                (role: "responder", text: "You can see it?"),
                (role: "caller",    text: "No."),
            ],
        ),

        // =====================================================================
        // SWITCH — the call changed after the gates
        //
        // One spoken beat (R8), but TWO declared roles: the silent "witness"
        // has no line and exists solely so a solo combatant cannot satisfy the
        // exchange. That is what keeps 1v1 quiet mid-fight.
        // =====================================================================

        // ---- tier 1: generic ------------------------------------------------
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Any,
            beats: [ (role: "caller", text: "Swap! {target}!") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Any,
            beats: [ (role: "caller", text: "On the {target}, now!") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Any,
            beats: [ (role: "caller", text: "{target}! Drop what you're doing!") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Any,
            beats: [ (role: "caller", text: "New target — {target}!") ],
        ),

        // ---- tier 2: by target ----------------------------------------------
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Class(Priest),
            beats: [ (role: "caller", text: "Priest is out of position — swap!") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Class(Mage),
            beats: [ (role: "caller", text: "Mage is out of cover! Swap!") ],
        ),
        (
            context: Switch,
            speakers: [ (role: "caller", class: Any), (role: "witness", class: Any) ],
            target: Class(Rogue),
            beats: [ (role: "caller", text: "There's the Rogue! On it!") ],
        ),
    ],
)
