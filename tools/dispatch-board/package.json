{
  "name": "dispatch-board",
  "version": "1.0.0",
  "private": true,
  "description": "Local ArenaSim Dispatch board: one daemon owning a SQLite board, serving MCP (Streamable HTTP), the web UI and the event feed",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "dispatch-board": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "node dist/cli.js serve",
    "test": "node --test test/*.test.mjs",
    "test:mutation": "node test/mutation/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "better-sqlite3": "12.11.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
